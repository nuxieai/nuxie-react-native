{
  "name": "@nuxie/react-native",
  "version": "0.2.0",
  "description": "Native Nuxie Experiences, Features and purchases for React Native and Expo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./plugin": "./app.plugin.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "ios",
    "android",
    "NuxieReactNative.podspec",
    "react-native.config.cjs",
    "app.plugin.cjs",
    "NATIVE-PINS.json"
  ],
  "scripts": {
    "build": "python3 scripts/bazel/sdk.py build",
    "typecheck": "python3 scripts/bazel/sdk.py typecheck",
    "test": "python3 scripts/bazel/sdk.py test",
    "lint": "eslint src tests",
    "clean": "node scripts/clean.mjs",
    "prepare:native": "python3 scripts/prepare-native.py",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "build:native": "python3 scripts/bazel/sdk.py build-native"
  },
  "keywords": [
    "nuxie",
    "react-native",
    "expo",
    "sdk"
  ],
  "author": "Nuxie",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": ">=0.86.0 <0.88.0"
  },
  "devDependencies": {
    "@bazel/bazelisk": "1.28.1",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "react-native": "./src/index.ts",
  "codegenConfig": {
    "name": "NuxieSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "ai.nuxie.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "Nuxie": "NuxieReactNative"
      }
    }
  }
}
